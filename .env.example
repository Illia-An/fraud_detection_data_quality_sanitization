# Local secrets — copy to .env and adjust for your environment.

# SQLAlchemy connection string (preferred)
# Experiment source DB: SummerCampain (VIEW dbo.TargetsByMetrics_RateGetAnswers).
# Example (Windows trusted connection):
# DATABASE_URL=mssql+pyodbc:///?odbc_connect=DRIVER%3D%7BODBC+Driver+17+for+SQL+Server%7D%3BSERVER%3DYOUR_SERVER%2C1433%3BDATABASE%3DSummerCampain%3BTrusted_Connection%3Dyes%3BEncrypt%3Dno
DATABASE_URL=mssql+pyodbc:///?odbc_connect=DRIVER%3D%7BODBC+Driver+17+for+SQL+Server%7D%3BSERVER%3DERP%2C1433%3BDATABASE%3DSummerCampain%3BTrusted_Connection%3Dyes%3BEncrypt%3Dno

# Discrete ODBC fields (optional; for raw pyodbc scripts)
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=ERP,1433
DB_DATABASE=SummerCampain
DB_UID=
DB_PWD=
DB_TRUSTED_CONNECTION=1
DB_ENCRYPT=no

# API settings
API_CORS_ORIGINS=http://localhost:4200
