# Local secrets — copy to .env and adjust for your environment.
# Do NOT commit .env (real values stay local only).

# SQLAlchemy connection string (preferred)
# Windows trusted connection — replace YOUR_SERVER and YourDatabase.
# DATABASE_URL=mssql+pyodbc:///?odbc_connect=DRIVER%3D%7BODBC+Driver+17+for+SQL+Server%7D%3BSERVER%3DYOUR_SERVER%2C1433%3BDATABASE%3DYourDatabase%3BTrusted_Connection%3Dyes%3BEncrypt%3Dno
DATABASE_URL=

# Discrete ODBC fields (optional; used by db/config and scripts)
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=YOUR_SERVER,1433
DB_DATABASE=YourDatabase
DB_UID=
DB_PWD=
DB_TRUSTED_CONNECTION=1
DB_ENCRYPT=no

# Data source for source=db process (SPEC §5.4)
# view (default) = SQL Server VIEW via DATABASE_URL
# snapshot = local SQLite daily snapshot (fast; refresh via scripts/refresh_q10012_snapshot.py)
SANITIZATION_SOURCE=view
# Optional; default sqlite:///data/q10012_snapshot.sqlite (repo-relative)
# SNAPSHOT_URL=sqlite:///data/q10012_snapshot.sqlite

# API settings
API_PORT=8001
API_CORS_ORIGINS=http://localhost:5173