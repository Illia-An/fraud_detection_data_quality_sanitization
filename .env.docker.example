# Docker / LAN monolith env — copy to .env.docker (do not commit secrets).
# Snapshot mode: no SQL Server / Windows Trusted Connection required.

SANITIZATION_SOURCE=snapshot
SNAPSHOT_URL=sqlite:///data/q10012_snapshot.sqlite

# Same-origin UI+API on :8000 (browser origin when opened as http://localhost:8000)
API_CORS_ORIGINS=http://localhost:8000

# Host port mapping (compose / run -p)
API_PORT=8000

# Optional: leave DATABASE_URL empty in snapshot mode
# DATABASE_URL=

# TTS Planner — local AP minutes snapshot (same idea as Q10012).
# Refresh on a host with AP access, then recreate the container:
#   uv run python scripts/refresh_tts_kpi_snapshot.py
# Until the file exists, set TTS_KPI_SOURCE=synthetic for the offline sample.
TTS_KPI_SOURCE=snapshot
TTS_KPI_SNAPSHOT_URL=sqlite:///data/tts_kpi_snapshot.sqlite
# Live AP (when DB team is ready) — comment snapshot above and set one of:
# TTS_KPI_SOURCE=sql
# TTS_KPI_DATABASE_URL=
# TTS_KPI_SOURCE=dreamfactory
# TTS_KPI_API_URL=
# TTS_KPI_API_KEY=
